<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= IGNITION SENSORS SYSTEM PLUGIN ================= -->
  <!-- Required for Gazebo Fortress to activate rendering engines for camera feeds -->
  <gazebo>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>
  
  <!-- Depth camera back link (box) -->
  <joint name="depth_camera_back_joint" type="fixed">
    <parent link="handle_middle"/>
    <child link="depth_camera_back_link"/>
    <origin xyz="0.015 0 0.13" rpy="0 0 0"/>
  </joint>

  <link name="depth_camera_back_link">
    <visual>
      <geometry><box size="0.0016 0.085 0.024"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.0016 0.085 0.024"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.05" x="0.0016" y="0.085" z="0.024">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>
  <gazebo reference="depth_camera_back_link"><material>Gazebo/White</material></gazebo>

  <!-- ================= LEFT CAMERA ================= -->
  <joint name="left_camera_joint" type="fixed">
    <parent link="depth_camera_back_link"/>
    <child link="left_camera_link"/>
    <origin xyz="0.0058 -0.03 0" rpy="0 0 0"/> 
  </joint>

  <link name="left_camera_link">
    <visual>
      <geometry><box size = "0.01 0.0155 0.0155"/></geometry>
    </visual>
    <collision>
      <geometry><box size = "0.01 0.0155 0.0155"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.02" x="0.01" y="0.0155" z="0.0155">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <gazebo reference="left_camera_link">
    <material>Gazebo/Black</material>
    <!-- IGNITION FORTRESS SENSOR TAG -->
    <sensor type="rgbd_camera" name="left_camera">
      <ignition_frame_id>left_camera_link_optical</ignition_frame_id>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <topic>depth_cam/left</topic>
      <camera>
        <horizontal_fov>1.27409</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>8.0</far>
        </clip>
        <lens>
          <intrinsics>
            <!-- fx = fy = width / (2 * tan(horizontal_fov/2)), computed for horizontal_fov=1.27409, width=640 -->
            <fx>432.43</fx>
            <fy>432.43</fy>
            <!-- cx = (width-1)/2, cy = (height-1)/2 -->
            <cx>319.5</cx>
            <cy>239.5</cy>
            <s>0</s>
          </intrinsics>
        </lens>
      </camera>
    </sensor>
  </gazebo>

  <!-- Left optical frame -->
  <joint name="left_camera_optical_joint" type="fixed">
    <parent link="left_camera_link"/>
    <child link="left_camera_link_optical"/>
    <origin xyz="0.01 0 0" rpy="${-pi/2} 0 ${-pi/2}"/> 
  </joint>
  <link name="left_camera_link_optical"/>

  <!-- ================= RIGHT CAMERA ================= -->
  <joint name="right_camera_joint" type="fixed">
    <parent link="depth_camera_back_link"/>
    <child link="right_camera_link"/>
    <origin xyz="0.0058 0.03 0" rpy="0 0 0"/> 
  </joint>

  <link name="right_camera_link">
    <visual>
      <geometry><box size = "0.01 0.0155 0.0155"/></geometry>
    </visual>
    <collision>
      <geometry><box size = "0.01 0.0155 0.0155"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.02" x="0.01" y="0.0155" z="0.0155">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <gazebo reference="right_camera_link">
    <material>Gazebo/Black</material>
    <!-- IGNITION FORTRESS SENSOR TAG -->
    <sensor type="rgbd_camera" name="right_camera">
    <ignition_frame_id>right_camera_link_optical</ignition_frame_id>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <topic>depth_cam/right</topic>
      <camera>
        <horizontal_fov>1.27409</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>8.0</far>
        </clip>
        <lens>
          <intrinsics>
            <!-- fx = fy = width / (2 * tan(horizontal_fov/2)), computed for horizontal_fov=1.27409, width=640 -->
            <fx>432.43</fx>
            <fy>432.43</fy>
            <!-- cx = (width-1)/2, cy = (height-1)/2 -->
            <cx>319.5</cx>
            <cy>239.5</cy>
            <s>0</s>
          </intrinsics>
        </lens>
      </camera>
    </sensor>
  </gazebo>

  <!-- Right optical frame -->
  <joint name="right_camera_optical_joint" type="fixed">
    <parent link="right_camera_link"/>
    <child link="right_camera_link_optical"/>
    <origin xyz="0.01 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="right_camera_link_optical"/>

</robot>