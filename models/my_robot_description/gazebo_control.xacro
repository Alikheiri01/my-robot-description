<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
            
            <left_joint>FL_joint</left_joint>
            <right_joint>FR_joint</right_joint>
            
            <wheel_separation>0.66108</wheel_separation>
            <wheel_radius>0.0925</wheel_radius> <max_linear_acceleration>30.0</max_linear_acceleration>
            <min_linear_acceleration>-30.0</min_linear_acceleration>
            <max_angular_acceleration>4.0</max_angular_acceleration>
            <min_angular_acceleration>-4.0</min_angular_acceleration>
            
            <max_linear_velocity>4.0</max_linear_velocity>
            <min_linear_velocity>-4.0</min_linear_velocity>
            <max_angular_velocity>4.0</max_angular_velocity>
            <min_angular_velocity>-4.0</min_angular_velocity>

            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <!-- CHANGED (2026-11-02): was 'tf'. robot_pose_relay.py now broadcasts
                 odom -> base_link from the TRUE pose, so RViz shows the robot where it
                 really is (also after teleports). The wheel odometry stays on /odom_wheel. -->
            <tf_topic>tf_wheel_unused</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <odom_publish_frequency>30</odom_publish_frequency>
        </plugin>

        <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
            
            <left_joint>BL_joint</left_joint>
            <right_joint>BR_joint</right_joint>
            
            <wheel_separation>0.66108</wheel_separation>
            <wheel_radius>0.0925</wheel_radius>
            
            <max_linear_acceleration>30.0</max_linear_acceleration>
            <min_linear_acceleration>-30.0</min_linear_acceleration>
            <max_angular_acceleration>4.0</max_angular_acceleration>
            <min_angular_acceleration>-4.0</min_angular_acceleration>
            <max_linear_velocity>4.0</max_linear_velocity>
            <min_linear_velocity>-4.0</min_linear_velocity>
            <max_angular_velocity>4.0</max_angular_velocity>
            <min_angular_velocity>-4.0</min_angular_velocity>

            <topic>cmd_vel</topic>
            <odom_topic>odom_rear_unused</odom_topic>
            <tf_topic>tf_rear_unused</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <odom_publish_frequency>30</odom_publish_frequency>

        </plugin>
        
        <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
            <topic>joint_states</topic>
        </plugin>
    </gazebo>

</robot>